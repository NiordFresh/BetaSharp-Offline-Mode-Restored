<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BetaSharp.Launcher.Features.Shell"

        x:Class="BetaSharp.Launcher.Features.Shell.ShellView" x:DataType="local:ShellViewModel"

        Icon="../../logo.ico" Title="BetaSharp Launcher" Width="600" Height="600"
        CanResize="False" WindowStartupLocation="CenterScreen">

    <TransitioningContentControl Content="{CompiledBinding Current}">
        <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.25" />
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
</Window>
